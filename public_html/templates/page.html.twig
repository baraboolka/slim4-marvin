{% extends "index.html.twig" %}

{% block content %}
   
    <h1>{{ page.title }}</h1>

    <div class="content-block">
       {{ page.text | raw }}
    </div>

    <div class="content-block content-block-editor">
        {{ page.text_editor | raw }}
    </div>    

    <div class="content-block content-block-subs">

        {% if children %}
        
            <h3>Sub-elements</h3>
            <ul>

            {% for child in children %}

                <li><a href="/page/{{ child.alias }}">{{ child.title }}</a></li>

            {% endfor %}

            </ul>
            
        {% endif %}

    </div>

{% endblock %}