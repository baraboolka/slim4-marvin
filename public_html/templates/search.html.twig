{% extends "index.html.twig" %}

{% block content %}
    <h1>Search</h1>

    <p>{{ message }}</p>

    <form action="/search" id="search-form" name="search_form" method="get">
        <input id="search-form-word" name="word" type="text">
        <div id="search-form-ok" onclick="document.search_form.submit();"></div>
    </form>

    {% if pages %}
        <h3>Pages</h3>

        <ul>

            {% for page in pages %}

            <li><a href="/page/{{ page.alias }}">{{ page.title }}</a></li>   

            {% endfor %}

        </ul>

    {% endif %}

    {% if galleries %}
        <h3>Galleries</h3>

        <ul>

            {% for gallery in galleries %}

            <li><a href="/gallery/{{ gallery.alias }}">{{ gallery.title }}</a></li>   

            {% endfor %}

        </ul>

    {% endif %}

{% endblock %}