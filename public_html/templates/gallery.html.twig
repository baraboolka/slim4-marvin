{% extends "index.html.twig" %}

{% block content %}

    <h1>{{ gallery.title }}</h1>

    <div class="content-block">
       {{ gallery.text | raw }}
    </div>

    <div class="content-block content-block-editor">
        {{ gallery.text_editor | raw }}
    </div>    

    <div class="content-block content-block-images">

        {% if images %} 

            <h3>Images</h3>
            <ul>

                {% for image in images %}

                    <li>
                        <a href="/galleries/{{ image.file }}" data-fancybox data-caption="{{ image.title }}">
                            <img src="/galleries/{{ image.file }}" alt="">
                        </a>
                    </li>

                {% endfor %}

            </ul>

        {% endif %}  

    </div>

    <div class="content-block content-block-subs">

        {% if children %}

            <h3>Sub-elements</h3>
            <ul>

            {% for child in children %}

                <li><a href="/gallery/{{ child.alias }}">{{ child.title }}</a></li>

            {% endfor %}

            </ul>

        {% endif %}
        
    </div>

{% endblock %}